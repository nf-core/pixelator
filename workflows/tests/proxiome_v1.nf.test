nextflow_workflow {

    name "Test Workflow PROXIOME"
    script "../proxiome.nf"
    workflow "PROXIOME"
    profile "test_proxiome_v1"

    tag "workflows"
    tag "pixelator"
    tag "pixelator/pna"

    test("Default parameters [design: proxiome-v1, panel: proxiome-v1-immuno-155-v1.1]") {
        when {

            params {
                skip_experiment_summary = true
                outdir = "$outputDir"
            }

            workflow {
                """
                def sample_meta = [ id:'sample1', design:'proxiome-v1', panel:'proxiome-v1-immuno-155-v1.1', technology:'proxiome-v1', single_end:false ]
                def lane_meta = sample_meta + [ row:1, parts:1 ]
                input[0] = Channel.of([
                        lane_meta,
                        [
                            file(params.pipelines_testdata_base_path + 'new-test-data/pna/fastq/sample1_R1.fastq.gz', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + 'new-test-data/pna/fastq/sample1_R2.fastq.gz', checkIfExists: true)
                        ],
                        []
                ])
                input[1] = Channel.of(['sample1', []])
                input[2] = Channel.of(['sample1', sample_meta])
                """
            }
        }

        then {
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // All stable path name, with a relative path
                    stable_name,
                ).match() }
            )
        }
    }
}
