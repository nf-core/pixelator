nextflow_process {

    name "Test Process PIXELATOR_AGGREGATE"
    script "../main.nf"
    process "PIXELATOR_AGGREGATE"
    tag "modules"
    tag "pixelator"
    tag "pixelator/aggregate"

    test("PNA aggregate - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'pool1', design:'proxiome-v2', panel:'proxiome-v2-immuno-155-prerelease', technology:'proxiome-v2-edgelist' ],
                    file(params.pipelines_testdata_base_path + 'new-test-data/pna/modules/edgelist/pool1.parquet', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.parquet,
                    process.out.report_json,
                    process.out.metadata_json,
                    process.out.log,
                ).match() }
            )
        }
    }

    test("PNA aggregate - small test") {
        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                    [ id:'pool1', design:'proxiome-v2', panel:'proxiome-v2-immuno-155-prerelease', technology:'proxiome-v2-edgelist' ],
                    file(params.pipelines_testdata_base_path + 'new-test-data/pna/modules/edgelist/pool1.parquet', checkIfExists: true),
                ]
                """
            }
        }

        then {
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.trace.succeeded().size(),
                    stable_name,
                    process.out.versions_pixelator,
                ).match() }
            )
        }
    }

    test("PNA aggregate - small test - multiple files") {
        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                    [ id:'pool1', design:'proxiome-v2', panel:'proxiome-v2-immuno-155-prerelease', technology:'proxiome-v2-edgelist' ],
                    [
                        file(params.pipelines_testdata_base_path + 'new-test-data/pna/modules/edgelist/pool1.parquet', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'new-test-data/pna/modules/edgelist/pool1_reseq.parquet', checkIfExists: true),
                    ]
                ]
                """
            }
        }

        then {
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.trace.succeeded().size(),
                    stable_name,
                    process.out.versions_pixelator,
                ).match() }
            )
        }
    }
}
