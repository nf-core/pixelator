nextflow_function {

    name "Test samplesheet grouping functions"
    script "../main.nf"
    function "group_samplesheet_units"
    tag "subworkflows"
    tag "subworkflows_local"
    tag "utils_nfcore_pixelator_pipeline"

    // Rows are [meta, panel_file, reads], as returned by validate_input_samplesheet

    test("Pooled samples - runs are grouped per pool, shared FASTQs are kept once") {

        when {
            function {
                """
                def base = [ pool:'pool1', design:'proxiome-v2', panel:'proxiome-v2-immuno-155-prerelease', single_end:false ]
                def run_a = ['a_R1.fastq.gz', 'a_R2.fastq.gz']
                def run_b = ['b_R1.fastq.gz', 'b_R2.fastq.gz']
                input[0] = [
                    [ base + [ id:'sample1', sample_alias:'S1', condition:'unstim', hash_index:1, row:1 ], [], run_a ],
                    [ base + [ id:'sample2', sample_alias:'S2', condition:'stim', hash_index:5, row:2 ], [], run_a ],
                    [ base + [ id:'sample1', sample_alias:'S1', condition:'unstim', hash_index:1, row:3 ], [], run_b ],
                    [ base + [ id:'sample2', sample_alias:'S2', condition:'stim', hash_index:5, row:4 ], [], run_b ],
                ]
                input[1] = 'proxiome-v2'
                """
            }
        }

        then {
            def result = function.result
            assertAll(
                { assert function.success },
                // One lane per unique FASTQ input, named after the first row it appears on
                { assert result.lanes.size() == 2 },
                { assert result.lanes.collect { lane -> lane[0].row } == [1, 3] },
                { assert result.lanes.collect { lane -> lane[1] } == [['a_R1.fastq.gz', 'a_R2.fastq.gz'], ['b_R1.fastq.gz', 'b_R2.fastq.gz']] },
                { assert result.lanes.every { lane -> lane[0].id == 'pool1' && lane[0].pool == 'pool1' && lane[0].parts == 2 } },
                // Sample-level fields are dropped from the pool meta
                { assert result.lanes.every { lane -> !lane[0].containsKey('hash_index') && !lane[0].containsKey('condition') } },
                { assert result.unit_panel_files == [['pool1', []]] },
                // Per-sample metadata is kept, without the row
                { assert result.sample_metas.collect { sample -> sample[0] } == ['sample1', 'sample2'] },
                { assert result.sample_metas.every { sample -> !sample[1].containsKey('row') && sample[1].pool == 'pool1' } },
                { assert result.options == [[ design:'proxiome-v2', panel:'proxiome-v2-immuno-155-prerelease' ]] },
            )
        }
    }

    test("Non-pooled samples - each sample is its own unit") {

        when {
            function {
                """
                def base = [ design:'proxiome-v1', panel:'proxiome-v1-immuno-155-v1.1', single_end:false ]
                input[0] = [
                    [ base + [ id:'sample1', row:1 ], [], ['s1_R1.fastq.gz', 's1_R2.fastq.gz'] ],
                    [ base + [ id:'sample2', row:2 ], [], ['s2_R1.fastq.gz', 's2_R2.fastq.gz'] ],
                ]
                input[1] = 'proxiome-v1'
                """
            }
        }

        then {
            def result = function.result
            assertAll(
                { assert function.success },
                { assert result.lanes.collect { lane -> lane[0].id } == ['sample1', 'sample2'] },
                { assert result.lanes.every { lane -> lane[0].parts == 1 } },
                { assert result.unit_panel_files.collect { unit -> unit[0] } == ['sample1', 'sample2'] },
            )
        }
    }

    test("Pool with a non-pooled technology - fails") {

        when {
            function {
                """
                input[0] = [
                    [ [ pool:'pool1', id:'sample1', design:'proxiome-v1', panel:'p', single_end:false, row:1 ], [], ['a_R1.fastq.gz', 'a_R2.fastq.gz'] ],
                ]
                input[1] = 'proxiome-v1'
                """
            }
        }

        then {
            assertAll(
                { assert function.failed },
                { assert function.stderr.join(" ").contains("does not use pooled samples") },
            )
        }
    }

    test("No pool with a pooled technology - fails") {

        when {
            function {
                """
                input[0] = [
                    [ [ id:'sample1', design:'proxiome-v2', panel:'p', single_end:false, row:1 ], [], ['a_R1.fastq.gz', 'a_R2.fastq.gz'] ],
                ]
                input[1] = 'proxiome-v2'
                """
            }
        }

        then {
            assertAll(
                { assert function.failed },
                { assert function.stderr.join(" ").contains("requires pooled samples") },
            )
        }
    }

    test("Mixed single-end and paired-end runs of a sample - fails") {

        when {
            function {
                """
                def base = [ id:'sample1', design:'proxiome-v1', panel:'p' ]
                input[0] = [
                    [ base + [ single_end:false, row:1 ], [], ['a_R1.fastq.gz', 'a_R2.fastq.gz'] ],
                    [ base + [ single_end:true, row:2 ], [], ['b_R1.fastq.gz'] ],
                ]
                input[1] = 'proxiome-v1'
                """
            }
        }

        then {
            assertAll(
                { assert function.failed },
                { assert function.stderr.join(" ").contains("must all be single-end or all paired-end") },
            )
        }
    }

    test("Different designs in the runs of a sample - fails") {

        when {
            function {
                """
                def base = [ id:'sample1', panel:'p', single_end:false ]
                input[0] = [
                    [ base + [ design:'proxiome-v1', row:1 ], null, ['a_R1.fastq.gz', 'a_R2.fastq.gz'] ],
                    [ base + [ design:'proxiome-v2', row:2 ], null, ['b_R1.fastq.gz', 'b_R2.fastq.gz'] ],
                ]
                input[1] = 'proxiome-v1'
                """
            }
        }

        then {
            assertAll(
                { assert function.failed },
                { assert function.stderr.join(" ").contains("must use the same design") },
            )
        }
    }

    test("Different panel files in the runs of a sample - fails") {

        when {
            function {
                """
                def base = [ id:'sample1', design:'proxiome-v1', panel:'p', single_end:false ]
                input[0] = [
                    [ base + [ row:1 ], 'panel_a.csv', ['a_R1.fastq.gz', 'a_R2.fastq.gz'] ],
                    [ base + [ row:2 ], 'panel_b.csv', ['b_R1.fastq.gz', 'b_R2.fastq.gz'] ],
                ]
                input[1] = 'proxiome-v1'
                """
            }
        }

        then {
            assertAll(
                { assert function.failed },
                { assert function.stderr.join(" ").contains("must use the same panel") },
            )
        }
    }
}
