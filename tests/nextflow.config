/*
========================================================================================
    Nextflow config file for running tests
========================================================================================
*/

params {
    // Default should point to a specific commit on github.com/nf-core/test-datasets, branch pixelator
    pipelines_testdata_base_path = System.getenv('NFT_TESTDATA_BASE_PATH') ?: "https://raw.githubusercontent.com/nf-core/test-datasets/e9d579feefe6f56ca4a513fcaa613590c9de757b/"
    modules_testdata_base_path   = "https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/"
    outdir                       = 'results'
}

// Fixes S3 access issues on self-hosted runners
aws.client.anonymous = true
