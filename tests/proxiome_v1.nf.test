nextflow_pipeline {

    name "Test PNA pipeline V1"
    script "../main.nf"

    tag "pixelator"
    tag "pixelator/pna"

    def test_config = new ConfigSlurper().parse(new File("tests/nextflow.config").toURI().toURL())
    def pipelines_testdata_base_path = test_config.params.pipelines_testdata_base_path as String

    test("Params: all") {

        when {
            params {
                input                                  = pipelines_testdata_base_path + '/samplesheet/pna/samplesheet_proxiome_v1.csv'
                input_basedir                          = pipelines_testdata_base_path + "/testdata/pna/"
                outdir                                 = "$outputDir"
                pna_graph_component_size_min_threshold = 100
                skip_experiment_summary                = false
                save_all                               = true
                technology                             = "proxiome-v1"
            }
        }

        then {
            // stable_path: All files + folders in ${params.outdir}/ with a stable name
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_content: All files in ${params.outdir}/ with stable content
            def stable_content = []

            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we tests pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_pixelator_software_versions.yml"),
                    // All stable path name, with a relative path
                    stable_path,
                    // All files with stable contents
                    stable_content,
                ).match() }
            )
        }
    }

    test("Params: default - stub") {

        options "-stub"

        when {
            params {
                input                                  = pipelines_testdata_base_path + '/samplesheet/pna/samplesheet_proxiome_v1.csv'
                input_basedir                          = pipelines_testdata_base_path + "/testdata/pna/"
                outdir                                 = "$outputDir"
                pna_graph_component_size_min_threshold = 100
                skip_experiment_summary                = false
                save_all                               = true
                technology                             = "proxiome-v1"
            }
        }

        then {
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_content: All files in ${params.outdir}/ with stable content
            def stable_content = []
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // All stable path name, with a relative path
                    stable_path,
                    // All files with stable contents
                    stable_content,
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_pixelator_software_versions.yml"),
                ).match() }
            )
        }
    }
}
