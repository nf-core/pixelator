/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test
    for the pna pipline

    Use as follows:
        nextflow run nf-core/pixelator -profile test_proxiome_v1,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name                    = 'Test profile for proxiome v1 data'
    config_profile_description             = 'Minimal test dataset to check pipeline function'

    // Input data
    input                                  = params.pipelines_testdata_base_path + '/samplesheet/pna/samplesheet_proxiome_v1.csv'
    input_basedir                          = params.pipelines_testdata_base_path + '/testdata/pna'

    pna_graph_component_size_min_threshold = 25

    skip_layout                            = false
    technology                             = "proxiome-v1"
    save_all                               = true
}

process {
    withName: '.*' {
        cpus   = 2
        memory = 3.GB
        time   = 2.h
    }

    // Run a smaller experiment summary for testing
    withName: EXPERIMENT_SUMMARY {
        ext.args = '-P test_mode="TRUE"'
    }
}
