/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test
    for the pna pipline

    Use as follows:
        nextflow run nf-core/pixelator -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name                    = 'Full test profile'
    config_profile_description             = 'Full test profile to check pipeline function'

    // Input data
    input                                  = "https://raw.githubusercontent.com/nf-core/test-datasets/f6fd3ce6cd14c0b94a4f6e26a02d9956b45824a7/new-test-data/samplesheet/pna/samplesheet_full_tests.csv"

    technology                             = "proxiome-v2"
}
