process {
    // All processes not defined here will rely on process labels and base.config.
    // Memory limits stay slightly below powers of two to leave OS/container-agent headroom on cloud/HPC hosts.

    withName: PIXELATOR_EDGELIST {
        cpus   = { 8     * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    withName: PIXELATOR_AGGREGATE {
        cpus          = { 8 * task.attempt }
        memory        = { 60.GB * task.attempt }
        time          = { 8.h * task.attempt }
        maxRetries    = 4
    }

    withName: PIXELATOR_GRAPH {
        cpus   = { 12 * task.attempt }
        memory = { 480.GB * task.attempt }
        time   = { 10.h * task.attempt }
    }

    withName: PIXELATOR_GRAPH_COLLAPSE {
        cpus   = { 8 * task.attempt }
        memory = { 30.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    withName: EXPERIMENT_SUMMARY {
        cpus   = { 16    * task.attempt }
        memory = { 60.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }
}
