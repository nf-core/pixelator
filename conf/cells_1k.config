process {
    // All processes not defined here will rely on process labels and base.config.

    withName: PIXELATOR_EDGELIST {
        cpus   = { 8     * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    withName: PIXELATOR_AGGREGATE {
        cpus          = { 8 * task.attempt }
        memory        = { 64.GB * task.attempt }
        time          = { 8.h * task.attempt }
        maxRetries    = 4
    }

    withName: PIXELATOR_GRAPH {
        cpus   = { 12 * task.attempt }
        memory = { 512.GB * task.attempt }
        time   = { 10.h * task.attempt }
    }

    withName: PIXELATOR_GRAPH_COLLAPSE {
        cpus   = { 8 }
        memory = { 32.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    withName: EXPERIMENT_SUMMARY {
        cpus   = { 16    * task.attempt }
        memory = { 64.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }
}
