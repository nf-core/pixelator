/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Runs the proxiome v2 test with a samplesheet that adds single-end samples
    read as the forward read and as the reverse read (reverse_read column) to the
    paired-end samples.

    Use as follows:
        nextflow run nf-core/pixelator -profile test_proxiome_v2_single_end,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

includeConfig 'test_proxiome_v2.config'

params {
    config_profile_name                    = 'Test profile for proxiome v2 data with single-end samples'
    config_profile_description             = 'Minimal test dataset to check the edgelist/aggregate workflow with paired-end and single-end samples'

    // Input data
    input                                  = params.pipelines_testdata_base_path + '/new-test-data/samplesheet/pna/samplesheet_proxiome_v2_single_end.csv'
}
